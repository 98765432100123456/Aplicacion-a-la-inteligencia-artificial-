# Copiar a .env y ajustar. Nunca subir .env al repositorio (RNFG06).
NODE_ENV=development
PORT=3000
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:4200

# MariaDB (local o en el servidor de despliegue)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ica
DB_PASSWORD=ica_dev
DB_NAME=ica_bienestar
# Socket Unix opcional cuando MariaDB está en la misma máquina, p. ej. /run/mysqld/mysqld.sock
DB_SOCKET_PATH=
DB_SSL=false

# JWT: generar con `openssl rand -base64 48`
JWT_SECRET=cambia-este-secreto-en-local
JWT_EXPIRES_IN=8h

# Recuperación de contraseña
FRONTEND_URL=http://localhost:4200
RESET_TOKEN_TTL_MINUTES=30

# Correo. Si SMTP_HOST está vacío, los correos se escriben en el log (solo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ICA Bienestar Animal <no-responder@ica-bienestar.local>"

# Administrador inicial que crea `npm run seed`
SEED_ADMIN_EMAIL=admin@ica-bienestar.local
SEED_ADMIN_PASSWORD=CambiarEsta.2026

# Solo para pruebas e2e locales del frontend (muchos ingresos seguidos). Prohibido en producción.
THROTTLE_DISABLED=false

# Recomendaciones con IA (Claude). Sin clave, el sistema usa recomendaciones por reglas.
# La clave se crea en https://console.anthropic.com y nunca se sube al repositorio.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=90000

# Firebase Authentication para ingresar con Google, Facebook o Microsoft (opcional).
# Datos de la consola de Firebase: Configuración del proyecto > General > Tu app web.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROVIDERS=google,facebook,microsoft

# Proxies delante de la API (1 con nginx; 2 con Caddy y nginx en el servidor)
TRUST_PROXY_HOPS=1

# Copiar a .env.servidor, diligenciar y proteger: chmod 600 .env.servidor
# Este archivo contiene secretos: nunca se sube al repositorio.

# Dominio público que apunta a la IP del servidor (registro DNS tipo A)
DOMINIO=bienestar.ejemplo.gov.co
CORS_ORIGINS=https://bienestar.ejemplo.gov.co
FRONTEND_URL=https://bienestar.ejemplo.gov.co

# MariaDB. Generar cada contraseña con: openssl rand -base64 32
DB_NAME=ica_bienestar
DB_USER=ica
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_SSL=false

# Sesiones. Generar con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h
RESET_TOKEN_TTL_MINUTES=30

# Correo saliente (obligatorio en producción para invitaciones y recuperación)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ICA Bienestar Animal <no-responder@ejemplo.gov.co>"

# Administrador inicial (solo para el primer arranque; cambiar la contraseña al ingresar)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Recomendaciones con IA. Vacío: el sistema usa recomendaciones por reglas.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=90000

# Ingreso con Google, Facebook y Microsoft. Vacío: solo correo y contraseña.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROVIDERS=google,facebook,microsoft

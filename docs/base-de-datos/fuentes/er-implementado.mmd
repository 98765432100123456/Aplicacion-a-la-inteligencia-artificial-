    roles {
        uuid id PK
        varchar code UK
        varchar name
        varchar description
        text permissions
        bool is_system
        bool active
        datetime created_at
        datetime updated_at
    }

    users {
        uuid id PK
        varchar first_name
        varchar last_name
        varchar email UK
        varchar document_number
        varchar phone
        varchar password_hash
        uuid role_id FK
        bool active
        int failed_login_attempts
        datetime locked_until
        datetime last_login_at
        datetime password_changed_at
        datetime created_at
        datetime updated_at
    }

    password_reset_tokens {
        uuid id PK
        uuid user_id FK
        varchar token_hash UK
        datetime expires_at
        datetime used_at
        datetime created_at
    }

    audit_logs {
        bigint id PK
        uuid actor_id
        varchar action
        varchar entity
        varchar entity_id
        json detail
        varchar ip
        datetime created_at
    }

    species {
        uuid id PK
        varchar code UK
        varchar name
        bool active
    }

    farms {
        uuid id PK
        varchar name
        varchar owner_name
        varchar owner_document
        varchar owner_phone
        varchar owner_email
        uuid owner_user_id FK
        varchar department
        varchar municipality
        varchar vereda
        varchar address
        decimal latitude
        decimal longitude
        decimal area_hectares
        varchar production_system
        text notes
        uuid created_by FK
        datetime created_at
        datetime updated_at
    }

    farm_species {
        uuid id PK
        uuid species_id FK
        int calves
        int young
        int adults
        uuid farm_id FK
    }

    evaluations {
        uuid id PK
        uuid farm_id FK
        uuid species_id FK
        uuid evaluator_id FK
        varchar status
        varchar checklist_version
        date visit_date
        int calves
        int young
        int adults
        varchar producer_type
        int sample_size
        text general_observation
        decimal score
        varchar level
        json results
        datetime last_saved_at
        datetime finished_at
        datetime created_at
    }

    evaluation_answers {
        uuid id PK
        varchar indicator_code
        varchar indicator_text
        varchar freedom
        varchar answer
        text observation
        uuid evaluation_id FK
    }

    recommendations {
        uuid id PK
        uuid evaluation_id FK
        varchar source
        varchar model
        text summary
        json items
        datetime created_at
    }

    reports {
        uuid id PK
        uuid evaluation_id FK
        varchar kind
        varchar file_name
        int size_bytes
        blob content
        datetime created_at
    }

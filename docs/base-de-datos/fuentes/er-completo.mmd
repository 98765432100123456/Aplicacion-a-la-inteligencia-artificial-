    users {
        uuid id PK
        varchar email UK
        uuid role_id FK
    }
    roles {
        uuid id PK
        varchar code UK
        text_arr permissions
    }
    farms {
        uuid id PK
        varchar name
        varchar municipality_code FK
        numeric latitude
        numeric longitude
        timestamptz deleted_at
    }
    farm_species {
        uuid farm_id PK,FK
        uuid species_id PK,FK
    }
    farm_inventory {
        uuid id PK
        uuid age_group_id FK
        int quantity
        date recorded_at
    }
    species {
        uuid id PK
        varchar code UK
        bool active
    }
    checklists {
        uuid id PK
        uuid species_id FK
        int version
        varchar status
    }
    criteria {
        uuid id PK
        uuid checklist_id FK
        uuid parent_id FK
        varchar dimension
        numeric weight
    }
    indicators {
        uuid id PK
        uuid criterion_id FK
        numeric weight
        bool is_critical
    }
    questions {
        uuid id PK
        uuid indicator_id FK
        varchar response_type
        bool required
    }
    evaluations {
        uuid id PK
        uuid farm_id FK
        uuid species_id FK
        uuid checklist_id FK
        uuid evaluator_id FK
        varchar status
        numeric total_score
        timestamptz last_saved_at
    }
    evaluation_answers {
        uuid id PK
        uuid evaluation_id FK
        uuid question_id FK
        jsonb value
        numeric score
    }
    findings {
        uuid id PK
        varchar kind
        smallint severity
    }
    recommendations {
        uuid id PK
        varchar source
        text original_text
        text text
    }
    improvement_actions {
        uuid id PK
        varchar priority
        date due_date
    }
    certificates {
        uuid id PK
        uuid evaluation_id UK
        varchar code UK
    }

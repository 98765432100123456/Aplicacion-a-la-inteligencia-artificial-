sequenceDiagram
    actor U as Usuario
    participant W as Angular
    participant A as Firebase Authentication
    participant F as Firestore
    U->>W: correo + contraseña
    W->>A: signInWithEmailAndPassword
    alt datos incorrectos
        A-->>W: auth/invalid-credential
        W-->>U: "Correo o contraseña incorrectos."
    else muchos intentos seguidos
        A-->>W: auth/too-many-requests
        W-->>U: espere o restablezca la contraseña
    else correctos
        A-->>W: usuario autenticado (token)
        W->>F: lee usuarios/{uid} y roles/{rol}
        alt usuario o rol inactivo
            W->>A: signOut
            W-->>U: "Su usuario está inactivo…"
        else activo
            W->>F: actualiza ultimoIngreso
            W->>F: escucha cambios del usuario y de su rol
            W-->>U: abre la ruta pedida con el menú según sus permisos
        end
    end

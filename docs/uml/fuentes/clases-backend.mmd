classDiagram
    direction TB
    class AuthController {
        +login(LoginDto, ip)
        +me(AuthUser)
        +forgotPassword(ForgotPasswordDto, ip)
        +validateResetToken(token)
        +resetPassword(ResetPasswordDto, ip)
        +changePassword(AuthUser, ChangePasswordDto, ip)
    }
    class AuthService {
        +login(LoginDto, ip) LoginResult
        +forgotPassword(email, ip)
        +resetPassword(ResetPasswordDto, ip)
        +changePassword(userId, ChangePasswordDto, ip) LoginResult
    }
    class PasswordResetService {
        +sendReset(User)
        +sendInvitation(User, roleName)
    }
    class UsersController {
        +findAll(ListUsersQuery)
        +findOne(id)
        +create(CreateUserDto, actor)
        +update(id, UpdateUserDto, actor)
        +setStatus(id, UserStatusDto, actor)
        +sendAccessLink(id, actor)
    }
    class UsersService {
        +findAll(query) Page~UserView~
        +findOne(id) UserView
        +create(dto, actor) UserView
        +update(id, dto, actor) UserView
        +setStatus(id, active, actor) UserView
        +sendAccessLink(id, actor)
    }
    class RolesController {
        +findAll()
        +permissions()
        +findOne(id)
        +create(CreateRoleDto, actor)
        +update(id, UpdateRoleDto, actor)
        +setStatus(id, RoleStatusDto, actor)
    }
    class RolesService {
        +findAll() RoleView[]
        +findOne(id) RoleView
        +create(dto, actor) RoleView
        +update(id, dto, actor) RoleView
        +setStatus(id, active, actor) RoleView
    }
    class AuditService {
        +record(AuditEntry, manager)
    }
    class MailService {
        +send(OutgoingMail)
        +passwordReset(to, name, link, minutes) OutgoingMail
        +invitation(to, name, roleName, link, hours) OutgoingMail
    }
    class JwtAuthGuard {
        +canActivate(context) bool
    }
    class PermissionsGuard {
        +canActivate(context) bool
    }
    class User {
        <<entity>>
    }
    class Role {
        <<entity>>
    }
    class PasswordResetToken {
        <<entity>>
    }
    class AuditLog {
        <<entity>>
    }

    AuthController --> AuthService
    AuthService --> PasswordResetService
    AuthService --> AuditService
    PasswordResetService --> MailService
    UsersController --> UsersService
    UsersService --> PasswordResetService
    UsersService --> AuditService
    RolesController --> RolesService
    RolesService --> AuditService
    AuthService ..> User
    UsersService ..> User
    UsersService ..> Role
    RolesService ..> Role
    PasswordResetService ..> PasswordResetToken
    AuditService ..> AuditLog
    JwtAuthGuard <.. AuthController : protege
    PermissionsGuard <.. UsersController : protege
    PermissionsGuard <.. RolesController : protege
